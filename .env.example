# --- Core ---
# Postgres with pgvector (docker-compose provides this)
DATABASE_URL=postgres://gnosis:gnosis@localhost:5434/gnosis
REDIS_URL=redis://localhost:6379
PORT=3000
# Public base URL of this API (used to build signed upload URLs)
API_URL=http://localhost:3000

# --- Identity ---
# local = fixed dev identity (bind loopback only, no real auth)
# supabase = verify Supabase access tokens
AUTH_MODE=local
# For AUTH_MODE=supabase, provide exactly one of:
# SUPABASE_JWT_SECRET=<legacy HS256 secret>
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_ISSUER=https://<project>.supabase.co/auth/v1

# --- Providers ---
# Embeddings are self-hosted by default (no key needed):
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIMS=384
# Generation (optional): gemini (free tier) or openai. Without either,
# answers are evidence-only (extractive) — see README.
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GNOSIS_GENERATOR_MODEL=gpt-4o-mini

# --- Jev / TypeSafe (optional, OFF by default; zero egress when off) ---
# Reranking stays disabled until tests and processing approval complete.
JEV_MODE=off
JEV_ROUTING_MODE=off
JEV_CLAIM_CHECK_MODE=off
JEV_MAX_RUN_HTTP_MS=2000
JEV_KILL_SWITCH=false
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Exact workspace UUID allowlist, comma-separated; no wildcards.
JEV_ALLOWED_WORKSPACE_IDS=
JEV_TIMEOUT_MS=1500
JEV_MAX_CANDIDATES=20
JEV_MAX_EXCERPT_BYTES=1600
JEV_MAX_REQUEST_BYTES=48000
JEV_MAX_RESPONSE_BYTES=65536
JEV_MAX_INFLIGHT_PER_WORKSPACE=2
JEV_MAX_INFLIGHT_PER_CREDENTIAL=4
JEV_SHADOW_SAMPLE_RATE=1.0
